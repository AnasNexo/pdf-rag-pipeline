# Copy this file to `.env` and fill in your own keys (or set these as real
# environment variables). The pipeline rotates across every key that is set,
# advancing to the next when one hits its free-tier quota — configure as many
# or as few as you have. Unset keys are skipped.
#
# Failover order (see config.PROVIDER_CHAIN): Groq keys first, then Gemini.

# --- Groq (Llama 3.3 for Q&A, Llama-4 multimodal for image descriptions) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- Google Gemini (gemini-2.5-flash for Q&A and vision) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Back-compat single-key names (used if the numbered ones above are unset).
GROQ_API_KEY=
GEMINI_API_KEY=
